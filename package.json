{
  "name": "w-flow",
  "displayName": "w-flow",
  "description": "Personal workflow automation",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.118.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WantenMN/w-flow.git"
  },
  "publisher": "Wanten",
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wflow-sidebar",
          "title": "w-flow",
          "icon": "media/w-flow.svg"
        }
      ]
    },
    "views": {
      "wflow-sidebar": [
        {
          "id": "w-flow.commandsView",
          "name": "Commands",
          "icon": "media/w-flow.svg"
        },
        {
          "id": "w-flow.notesView",
          "name": "Notes",
          "icon": "media/w-flow.svg"
        },
        {
          "id": "w-flow.worksView",
          "name": "Works",
          "icon": "media/w-flow.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "w-flow.openVault",
        "title": "Open Vault"
      },
      {
        "command": "w-flow.openDailyLog",
        "title": "Open Daily Log"
      },
      {
        "command": "w-flow.insertTime",
        "title": "Insert Time Header"
      },
      {
        "command": "w-flow.insertNoteTemplate",
        "title": "Insert Note Template"
      },
      {
        "command": "w-flow.createNote",
        "title": "Create Note"
      },
      {
        "command": "w-flow.refreshNotes",
        "title": "Refresh Notes"
      },
      {
        "command": "w-flow.refreshWorks",
        "title": "Refresh Works"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "w-flow.refreshNotes",
          "when": "view == w-flow.notesView",
          "group": "navigation"
        },
        {
          "command": "w-flow.refreshWorks",
          "when": "view == w-flow.worksView",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "w-flow.insertTime",
        "key": "ctrl+i",
        "when": "editorTextFocus && editorLangId == 'markdown' && resourcePath =~ /vault/"
      },
      {
        "command": "w-flow.insertNoteTemplate",
        "key": "alt+t",
        "when": "editorTextFocus && editorLangId == 'markdown'"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "release": "vsce package --no-dependencies"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@types/node": "24.x",
    "@types/vscode": "^1.118.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  }
}
